{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "PII-isolated authenticated user profile owned strictly by the user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching document owner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "fullName", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Company realtime coordination root synchronized from PostgreSQL.",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["companyId", "ownerUid", "companyName", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Membership record gating access to company realtime presence and notifications.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "member", "viewer"],
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "companyId", "role", "createdAt", "updatedAt"]
    },
    "WorkspacePresence": {
      "title": "WorkspacePresence",
      "description": "Realtime operator presence inside an authorized company workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["online", "away"],
          "minLength": 1,
          "maxLength": 16
        },
        "activeRoute": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "companyId", "displayName", "status", "activeRoute", "updatedAt"]
    },
    "WorkspaceNotification": {
      "title": "WorkspaceNotification",
      "description": "User-scoped realtime notification state inside an authorized workspace.",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["architecture", "security", "governance", "workflow"],
          "minLength": 1,
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "companyId",
        "recipientUid",
        "category",
        "title",
        "body",
        "isRead",
        "createdAt",
        "updatedAt"
      ]
    },
    "LicenseRegistration": {
      "title": "LicenseRegistration",
      "description": "Signed software license key entitlement record validated before unlocking WENDORO features (zero PII).",
      "type": "object",
      "properties": {
        "licenseKey": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64,
          "pattern": "^WND-[A-Z]{4}-[A-Z0-9]{8}-[A-Z0-9]{8}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "organizationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "starter", "business", "professional", "enterprise", "white_label", "self_hosted"],
          "minLength": 1,
          "maxLength": 32
        },
        "platform": {
          "type": "string",
          "enum": ["desktop", "android", "both"],
          "minLength": 1,
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": ["active", "revoked", "expired"],
          "minLength": 1,
          "maxLength": 16
        },
        "maxDevices": {
          "type": "integer"
        },
        "signature": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Z0-9]+$"
        },
        "expiresAt": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "licenseKey",
        "ownerUid",
        "organizationName",
        "planTier",
        "platform",
        "status",
        "maxDevices",
        "signature",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "LicenseDeviceActivation": {
      "title": "LicenseDeviceActivation",
      "description": "Device seat binding record under a verified WENDORO license key.",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "licenseKey": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64,
          "pattern": "^WND-[A-Z]{4}-[A-Z0-9]{8}-[A-Z0-9]{8}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "platform": {
          "type": "string",
          "enum": ["desktop", "android", "web"],
          "minLength": 1,
          "maxLength": 16
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "deviceId",
        "licenseKey",
        "ownerUid",
        "deviceName",
        "platform",
        "appVersion",
        "activatedAt",
        "lastVerifiedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Strictly private PII document readable and writable only by the authenticated user."
    },
    "/workspaces/{companyId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Company realtime workspace root owned by workspace creator or admin."
    },
    "/workspaces/{companyId}/members/{userId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Membership gate controlling access to presence and notification subcollections."
    },
    "/workspaces/{companyId}/presence/{userId}": {
      "schema": { "$ref": "#/entities/WorkspacePresence" },
      "description": "Realtime operator presence documents within an authorized company workspace."
    },
    "/workspaces/{companyId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/WorkspaceNotification" },
      "description": "Recipient-scoped realtime notifications inside a company workspace."
    },
    "/licenses/{licenseKey}": {
      "schema": { "$ref": "#/entities/LicenseRegistration" },
      "description": "User-owned software license keys validated before unlocking Desktop and Android features."
    },
    "/licenses/{licenseKey}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/LicenseDeviceActivation" },
      "description": "Bound Desktop and Android device activations governed by the parent license key."
    }
  }
}
