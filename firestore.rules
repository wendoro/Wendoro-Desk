rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isWorkspaceOwner(companyId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/workspaces/$(companyId))
        && get(/databases/$(database)/documents/workspaces/$(companyId)).data.ownerUid == request.auth.uid;
    }

    function isWorkspaceMember(companyId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/workspaces/$(companyId)/members/$(request.auth.uid));
    }

    function isAdmin() {
      return isVerifiedUser()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || request.auth.token.email == 'wendoro.dev@gmail.com'
        );
    }

    function isLicenseOwner(licenseKey) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/licenses/$(licenseKey))
        && get(/databases/$(database)/documents/licenses/$(licenseKey)).data.ownerUid == request.auth.uid;
    }

    // Validation Helpers (Anti-Update-Gap Blueprints)
    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspace(data, companyId) {
      return data.keys().hasAll(['companyId', 'ownerUid', 'companyName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['companyId', 'ownerUid', 'companyName', 'createdAt', 'updatedAt'])
        && data.companyId is string && data.companyId.size() >= 1 && data.companyId.size() <= 128
        && data.companyId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.companyId == companyId
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceMember(data, companyId, memberId) {
      return data.keys().hasAll(['uid', 'companyId', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'companyId', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == memberId
        && data.companyId is string && data.companyId.size() >= 1 && data.companyId.size() <= 128
        && data.companyId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.companyId == companyId
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 32
        && data.role in ['owner', 'member', 'viewer']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspacePresence(data, companyId, userId) {
      return data.keys().hasAll(['uid', 'companyId', 'displayName', 'status', 'activeRoute', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'companyId', 'displayName', 'status', 'activeRoute', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.companyId is string && data.companyId.size() >= 1 && data.companyId.size() <= 128
        && data.companyId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.companyId == companyId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 16
        && data.status in ['online', 'away']
        && data.activeRoute is string && data.activeRoute.size() >= 1 && data.activeRoute.size() <= 80
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceNotification(data, companyId) {
      return data.keys().hasAll(['companyId', 'recipientUid', 'category', 'title', 'body', 'isRead', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['companyId', 'recipientUid', 'category', 'title', 'body', 'isRead', 'createdAt', 'updatedAt'])
        && data.companyId is string && data.companyId.size() >= 1 && data.companyId.size() <= 128
        && data.companyId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.companyId == companyId
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128
        && data.recipientUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 32
        && data.category in ['architecture', 'security', 'governance', 'workflow']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 500
        && data.isRead is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPurchasedModulesList(mods) {
      return mods is list
        && mods.size() <= 32
        && mods.hasOnly([
          'catalogue',
          'crm',
          'sales',
          'purchase',
          'inventory',
          'accounting',
          'hrms',
          'projects',
          'marketing',
          'support',
          'documents',
          'industry_retail',
          'industry_manufacturing',
          'industry_electronics',
          'industry_realestate',
          'industry_services'
        ]);
    }

    function isValidLicenseRegistration(data, licenseKey) {
      return data.keys().hasAll(['licenseKey', 'ownerUid', 'organizationName', 'planTier', 'platform', 'status', 'maxDevices', 'signature', 'expiresAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['licenseKey', 'ownerUid', 'organizationName', 'planTier', 'platform', 'status', 'maxDevices', 'signature', 'expiresAt', 'purchasedModules', 'createdAt', 'updatedAt'])
        && data.licenseKey is string && data.licenseKey.size() >= 12 && data.licenseKey.size() <= 64
        && data.licenseKey.matches('^WND-[A-Z]{4}-[A-Z0-9]{8}-[A-Z0-9]{8}$')
        && data.licenseKey == licenseKey
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.organizationName is string && data.organizationName.size() >= 1 && data.organizationName.size() <= 120
        && data.planTier is string && data.planTier.size() >= 1 && data.planTier.size() <= 32
        && data.planTier in ['free', 'starter', 'business', 'professional', 'enterprise', 'white_label', 'self_hosted']
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 16
        && data.platform in ['desktop', 'android', 'both']
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 16
        && data.status in ['active', 'revoked', 'expired']
        && data.maxDevices is int && data.maxDevices >= 1 && data.maxDevices <= 2000
        && data.signature is string && data.signature.size() >= 8 && data.signature.size() <= 128
        && data.signature.matches('^[A-Z0-9]+$')
        && data.expiresAt is string && data.expiresAt.size() >= 4 && data.expiresAt.size() <= 40
        && (!('purchasedModules' in data) || isValidPurchasedModulesList(data.purchasedModules))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLicenseDeviceActivation(data, licenseKey, deviceId) {
      return data.keys().hasAll(['deviceId', 'licenseKey', 'ownerUid', 'deviceName', 'platform', 'appVersion', 'activatedAt', 'lastVerifiedAt'])
        && data.keys().hasOnly(['deviceId', 'licenseKey', 'ownerUid', 'deviceName', 'platform', 'appVersion', 'activatedAt', 'lastVerifiedAt'])
        && data.deviceId is string && data.deviceId.size() >= 4 && data.deviceId.size() <= 128
        && data.deviceId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.deviceId == deviceId
        && data.licenseKey is string && data.licenseKey.size() >= 12 && data.licenseKey.size() <= 64
        && data.licenseKey.matches('^WND-[A-Z]{4}-[A-Z0-9]{8}-[A-Z0-9]{8}$')
        && data.licenseKey == licenseKey
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 16
        && data.platform in ['desktop', 'android', 'web']
        && data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 32
        && data.activatedAt is timestamp
        && data.lastVerifiedAt is timestamp;
    }

    // 1. User Private PII Profile
    match /users/{userId}/private/profile {
      allow get: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId;

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserPrivateProfile(incoming(), userId)
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'fullName', 'updatedAt']);

      allow delete: if false;
    }

    // 2. Company Realtime Workspaces
    match /workspaces/{companyId} {
      allow get: if isValidId(companyId)
        && isVerifiedUser()
        && (resource == null || resource.data.ownerUid == request.auth.uid || isWorkspaceMember(companyId));

      allow list: if isVerifiedUser()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(companyId)
        && isVerifiedUser()
        && isValidWorkspace(incoming(), companyId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(companyId)
        && isVerifiedUser()
        && isValidWorkspace(incoming(), companyId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().companyId == existing().companyId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'updatedAt']);

      allow delete: if false;

      // 2a. Workspace Membership Gate
      match /members/{memberId} {
        allow get: if isValidId(companyId)
          && isValidId(memberId)
          && isVerifiedUser()
          && (request.auth.uid == memberId || isWorkspaceOwner(companyId));

        allow list: if isVerifiedUser()
          && resource.data.uid == request.auth.uid;

        allow create: if isValidId(companyId)
          && isValidId(memberId)
          && isVerifiedUser()
          && isValidWorkspaceMember(incoming(), companyId, memberId)
          && exists(/databases/$(database)/documents/workspaces/$(companyId))
          && (
            isWorkspaceOwner(companyId)
            || (request.auth.uid == memberId && incoming().role == 'member' && get(/databases/$(database)/documents/workspaces/$(companyId)).data.ownerUid == request.auth.uid)
          )
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(companyId)
          && isValidId(memberId)
          && isVerifiedUser()
          && isValidWorkspaceMember(incoming(), companyId, memberId)
          && isWorkspaceOwner(companyId)
          && incoming().uid == existing().uid
          && incoming().companyId == existing().companyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']);

        allow delete: if isValidId(companyId)
          && isValidId(memberId)
          && isWorkspaceOwner(companyId);
      }

      // 2b. Realtime Presence Subcollection (Master Gate: Member or Owner)
      match /presence/{userId} {
        allow get: if isValidId(companyId)
          && isValidId(userId)
          && (isWorkspaceMember(companyId) || isWorkspaceOwner(companyId));

        allow list: if isVerifiedUser()
          && resource.data.uid == request.auth.uid;

        allow create: if isValidId(companyId)
          && isValidId(userId)
          && isVerifiedUser()
          && request.auth.uid == userId
          && (isWorkspaceMember(companyId) || isWorkspaceOwner(companyId))
          && isValidWorkspacePresence(incoming(), companyId, userId)
          && incoming().updatedAt == request.time;

        allow update: if isValidId(companyId)
          && isValidId(userId)
          && isVerifiedUser()
          && isValidWorkspacePresence(incoming(), companyId, userId)
          && request.auth.uid == userId
          && (isWorkspaceMember(companyId) || isWorkspaceOwner(companyId))
          && incoming().uid == existing().uid
          && incoming().companyId == existing().companyId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'status', 'activeRoute', 'updatedAt']);

        allow delete: if isValidId(companyId)
          && isValidId(userId)
          && isVerifiedUser()
          && request.auth.uid == userId;
      }

      // 2c. Workspace Notifications Subcollection
      match /notifications/{notificationId} {
        allow get: if isValidId(companyId)
          && isValidId(notificationId)
          && isVerifiedUser()
          && resource.data.recipientUid == request.auth.uid;

        allow list: if isVerifiedUser()
          && resource.data.recipientUid == request.auth.uid;

        allow create: if isValidId(companyId)
          && isValidId(notificationId)
          && isVerifiedUser()
          && (isWorkspaceOwner(companyId) || isWorkspaceMember(companyId))
          && isValidWorkspaceNotification(incoming(), companyId)
          && incoming().recipientUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(companyId)
          && isValidId(notificationId)
          && isVerifiedUser()
          && isValidWorkspaceNotification(incoming(), companyId)
          && existing().recipientUid == request.auth.uid
          && incoming().recipientUid == existing().recipientUid
          && incoming().companyId == existing().companyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']);

        allow delete: if isValidId(companyId)
          && isValidId(notificationId)
          && isVerifiedUser()
          && resource.data.recipientUid == request.auth.uid;
      }
    }

    // 3. Software License Keys & Device Bindings (Zero-PII Verification)
    match /licenses/{licenseKey} {
      allow get: if isValidId(licenseKey)
        && isVerifiedUser()
        && (isAdmin() || (resource != null && resource.data.ownerUid == request.auth.uid));

      allow list: if isVerifiedUser()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(licenseKey)
        && isVerifiedUser()
        && isValidLicenseRegistration(incoming(), licenseKey)
        && incoming().ownerUid == request.auth.uid
        && incoming().status == 'active'
        && (isAdmin() || (incoming().planTier == 'free' && incoming().maxDevices <= 3))
        && (!('purchasedModules' in incoming()) || isAdmin() || incoming().purchasedModules.size() == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(licenseKey)
        && isVerifiedUser()
        && isValidLicenseRegistration(incoming(), licenseKey)
        && incoming().licenseKey == existing().licenseKey
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['organizationName', 'planTier', 'platform', 'status', 'maxDevices', 'expiresAt', 'purchasedModules', 'updatedAt']))
          || (
            existing().ownerUid == request.auth.uid
            && existing().status == 'active'
            && incoming().planTier == existing().planTier
            && incoming().maxDevices == existing().maxDevices
            && incoming().status == existing().status
            && (!('purchasedModules' in existing()) || ('purchasedModules' in incoming() && incoming().purchasedModules.hasAll(existing().purchasedModules)))
            && incoming().diff(existing()).affectedKeys().hasOnly(['organizationName', 'purchasedModules', 'updatedAt'])
          )
        );

      allow delete: if false;

      // 3a. Device Activation Subcollection (Master Gate: Parent License Active + Owner)
      match /devices/{deviceId} {
        allow get: if isValidId(licenseKey)
          && isValidId(deviceId)
          && isVerifiedUser()
          && (isAdmin() || isLicenseOwner(licenseKey));

        allow list: if isVerifiedUser()
          && resource.data.ownerUid == request.auth.uid;

        allow create: if isValidId(licenseKey)
          && isValidId(deviceId)
          && isVerifiedUser()
          && isValidLicenseDeviceActivation(incoming(), licenseKey, deviceId)
          && incoming().ownerUid == request.auth.uid
          && exists(/databases/$(database)/documents/licenses/$(licenseKey))
          && get(/databases/$(database)/documents/licenses/$(licenseKey)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/licenses/$(licenseKey)).data.status == 'active'
          && incoming().activatedAt == request.time
          && incoming().lastVerifiedAt == request.time;

        allow update: if isValidId(licenseKey)
          && isValidId(deviceId)
          && isVerifiedUser()
          && isValidLicenseDeviceActivation(incoming(), licenseKey, deviceId)
          && existing().ownerUid == request.auth.uid
          && incoming().deviceId == existing().deviceId
          && incoming().licenseKey == existing().licenseKey
          && incoming().ownerUid == existing().ownerUid
          && incoming().activatedAt == existing().activatedAt
          && incoming().lastVerifiedAt == request.time
          && get(/databases/$(database)/documents/licenses/$(licenseKey)).data.status == 'active'
          && incoming().diff(existing()).affectedKeys().hasOnly(['deviceName', 'platform', 'appVersion', 'lastVerifiedAt']);

        allow delete: if isValidId(licenseKey)
          && isValidId(deviceId)
          && isVerifiedUser()
          && (isAdmin() || isLicenseOwner(licenseKey));
      }
    }
  }
}
