# ==============================================================================
# SERVER-SIDE SECRETS (NEVER prefix with VITE_ or commit real values)
# Configure these via `npx wrangler secret put <NAME>` or AI Studio Secrets.
# ==============================================================================

# Gemini AI Gateway API Key (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL connection string (Neon / Self-Hosted; use Hyperdrive in Workers)
DATABASE_URL="postgresql://user:password@host:5432/wendoro?sslmode=require"

# Better Auth cryptographic signing secret (32+ random bytes)
BETTER_AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM_SECRET"

# Public application URL for OAuth callbacks
APP_URL="MY_APP_URL"

# ==============================================================================
# OPTIONAL CLIENT-SIDE FIREBASE CONFIG (for clean Cloudflare / OSS clones)
# Local dev can alternatively copy firebase-applet-config.example.json
# to firebase-applet-config.json (gitignored).
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
